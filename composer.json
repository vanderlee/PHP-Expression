{
    "name": "vanderlee/expression",
    "description": "Safe, eval()-based simple and extendable expression parser",
    "type": "library",
    "keywords": ["expression", "parser", "eval", "math"],
    "homepage": "https://github.com/vanderlee/PHP-Expression",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/vanderlee/PHP-Expression/issues",
        "source": "https://github.com/vanderlee/PHP-Expression/"
    },
    "require": {
        "php": ">=7.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^7.5 || ^9.6 || ^11.5"
    },
    "suggest": {
        "ext-bcmath": "Required only for the optional exact decimal BcMathBackend"
    },
    "autoload": {
        "psr-4": {
            "Vanderlee\\Expression\\": "classes/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
